[Unit]
Description=racksdock tenant launch configuration (startup script or Docker container)
# launch.json is written by cloud-init's init stage; the tenant user-data's runcmd also starts this unit explicitly.
# Not ordered after cloud-final.service (it runs after multi-user.target: ordering cycle, see racksdock-node-agent.service).
After=cloud-config.service docker.service network-online.target
Wants=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/racksdock-launch
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
