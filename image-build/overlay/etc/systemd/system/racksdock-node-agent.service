[Unit]
Description=racksdock node agent (attestation, status, allowlisted health)
After=network-online.target cloud-init.target
Wants=network-online.target

[Service]
Type=simple
# Runs as root inside the tenant's VM: it formats and mounts the encrypted data disk, reads cloud-init's copy of the user-data
# for the attestation hash and talks to the GPUs. The VM is the tenant's trust domain; the tenant (root) can inspect or stop it
# (docs/node-agent-privileges.md). It only answers signed, allowlisted challenges relayed by the host.
Environment=RACKSDOCK_NODE_AGENT_MODE=real
Environment=RACKSDOCK_AGENT_TRANSPORT=vsock
Environment=RACKSDOCK_TRUST_MODE=prod
EnvironmentFile=-/etc/racksdock/node-agent.env
ExecStart=/usr/local/bin/racksdock-node-agent
Restart=always
RestartSec=2
RuntimeDirectory=racksdock
RuntimeDirectoryPreserve=yes
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
